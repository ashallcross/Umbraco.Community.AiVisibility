<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.AiVisibility</PackageId>
    <Product>Umbraco.Community.AiVisibility</Product>
    <Title>AI Visibility for Umbraco</Title>
    <Version>1.1.2</Version>
    <Description>AI visibility for Umbraco — request log + dashboard, robots.txt audit, content negotiation, llms.txt manifests, and *.md page rendering. Auto-generates per-page Markdown at {url}.md, /llms.txt, and /llms-full.txt; surfaces an AI Traffic dashboard so editors can see who's reading the site; audits robots.txt against the AI-crawler list. Dual-strategy renderer (in-process Razor with HTTP loopback fallback) works on clean Umbraco installs and agency-built sites that hijack Razor with custom view models. Built for Umbraco v17+.</Description>
    <Authors>Adam Shallcross</Authors>
    <PackageTags>umbraco-marketplace;umbraco;ai;ai-search;ai-visibility;llms-txt;markdown;geo;chatgpt;claude;perplexity</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v1.1.2 — agency-site correctness + adoption friction. See https://github.com/ashallcross/Umbraco.Community.AiVisibility/blob/main/CHANGELOG.md for the full changelog.</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ashallcross/Umbraco.Community.AiVisibility</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ashallcross/Umbraco.Community.AiVisibility.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story 1.1 — Markdown extraction pipeline -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="ReverseMarkdown" />
    <PackageReference Include="SmartReader" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.AiVisibility.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Story 9.1 — the v17 ship package consumes the extracted HTTP-agnostic
       business logic from Core via ProjectReference.
       PrivateAssets="all" suppresses the auto-generated NuGet <dependency> on an
       (unpublished) Core package — Story 9.1 must NOT push a Core NuGet (that is
       Story 9.4's lockstep ship). Instead Core.dll is bundled into the v17 .nupkg
       (IncludeCoreAssemblyInPackage target below) so the package is self-contained
       and installable for the manual gate. Story 9.4 owns the final
       bundle-vs-separate-NuGet packaging decision (Open Question 1). -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCoreAssemblyInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.AiVisibility.Core\Umbraco.Community.AiVisibility.Core.csproj" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="IncludeCoreAssemblyInPackage">
    <PropertyGroup>
      <_CoreAssemblyToBundle>$(OutputPath)Umbraco.Community.AiVisibility.Core.dll</_CoreAssemblyToBundle>
    </PropertyGroup>
    <!-- Fail the pack loudly rather than shipping a .nupkg silently missing
         Core.dll (the package would then throw TypeLoadException at runtime). -->
    <Error Condition="!Exists('$(_CoreAssemblyToBundle)')"
           Text="AiVisibility: expected the bundled Core assembly at '$(_CoreAssemblyToBundle)' but it was not found — the v17 package would ship without its Core dependency. Build the solution before packing." />
    <ItemGroup>
      <BuildOutputInPackage Include="$(_CoreAssemblyToBundle)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Don't include the Client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\README.md')" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <!-- MSBuild auto-registers the TagHelper namespace in the consuming
         project's Views/_ViewImports.cshtml on dotnet build. The targets
         file ships under build/<TFM>/ so NuGet auto-imports it when the
         package is referenced by a net10.0 project. -->
    <None Include="build\net10.0\Umbraco.Community.AiVisibility.targets"
          Pack="true"
          PackagePath="build\net10.0\" />
  </ItemGroup>

</Project>
