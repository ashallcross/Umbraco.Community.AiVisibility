<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <!-- This is a TEST harness, never shipped. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco v13 site host + Cogworks Clean 4.2.2 starter (the v13-compatible
         Clean line — NOT 7.0.5, which targets v17). Clean seeds realistic demo
         content via package migration on unattended install, so the v13 .md /
         /llms.txt / extraction smokes run against real Razor-rendered HTML. -->
    <PackageReference Include="Clean" />
    <PackageReference Include="Umbraco.Cms" />
    <!-- NOTE: NO Umbraco.Cms.DevelopmentMode.Backoffice — that RCL is a v14+/v17
         development-mode package (earliest published 17.0.0); on v13 the backoffice
         ships inside the Umbraco.Cms meta-package, so the v13 TestSite needs no
         separate reference. -->
    <PackageReference Include="Clean.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <!-- Consume the v13 shell exactly as an adopter would — via the package
         project. Mirrors how the v17 TestSite references the v17 ship package. -->
    <ProjectReference Include="..\Umbraco.Community.AiVisibility.V13\Umbraco.Community.AiVisibility.V13.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
