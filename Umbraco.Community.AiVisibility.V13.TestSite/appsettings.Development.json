{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": true
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Adam V13",
        "UnattendedUserEmail": "v13@local.test",
        "UnattendedUserPassword": "V13#Password1"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "AiVisibility": {
    "SiteName": "Acme Docs (v13)",
    "SiteSummary": "Acme product documentation — v13 lite SKU test harness",
    "Hreflang": { "Enabled": true },
    "RequestLog": {
      "Enabled": true
    },
    "LlmsTxtBuilder": {
      "SectionGrouping": [
        {
          "Title": "Articles",
          "DocTypeAliases": [ "Article" ]
        },
        {
          "Title": "Documentation",
          "DocTypeAliases": [ "content", "home" ]
        }
      ]
    },
    "RobotsAuditor": {
      "DevFetchPort": 44315
    }
  }
}
